# Addresses this relay listens on: one in the phone gateway's network, one
# in the bridge's. Both must be local addresses of this host.
RTP_RELAY_LAN_IP=192.168.1.10
RTP_RELAY_OVERLAY_IP=10.1.1.5

# One "lanPort:overlayPort" pair per call that has to be possible at the
# same time. A pipe carries exactly one call: it holds a single endpoint
# per side, so two calls sharing a pipe would send each side the other
# call's audio. The bridge's BRIDGE_RELAY_LAN_PORT / _OVERLAY_PORT (per
# line) name the pipe that line uses.
RTP_RELAY_PIPES=40000:40001,40010:40011

# Who may send media into each side. Without these, any host able to reach
# a port takes the call's media over by sending one packet.
RTP_RELAY_LAN_PEERS=192.168.1.1
RTP_RELAY_OVERLAY_PEERS=10.1.1.1

# How long a pipe keeps the endpoints it learned before it is free for the
# next call.
RTP_RELAY_IDLE_SECONDS=30
