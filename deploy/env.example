# Template for /etc/fritzbox-talk-bridge/env (chmod 600, owned by the
# service user - contains credentials). See docs/CONFIG.md for the full
# reference of every variable and when each one is needed.

BRIDGE_SIP_USER=
BRIDGE_SIP_PASS=
BRIDGE_GATEWAY_HOST=
BRIDGE_LOCAL_IP=

# Only needed if a relay sits between this host and the gateway (see
# docs/CONFIG.md "Media relay") - leave unset for direct reachability.
#BRIDGE_PROXY_HOST=
#BRIDGE_PROXY_PORT=
#BRIDGE_CONTACT_HOST=
#BRIDGE_CONTACT_PORT=
#BRIDGE_RELAY_LAN_HOST=
#BRIDGE_RELAY_LAN_PORT=
#BRIDGE_RELAY_OVERLAY_HOST=
#BRIDGE_RELAY_OVERLAY_PORT=

BRIDGE_WS_URL=
BRIDGE_INTERNAL_SECRET=
BRIDGE_BACKEND_URL=
BRIDGE_DEFAULT_ROOM=

# Number handling for Talk's "call a phone number" UI - see docs/CONFIG.md.
#BRIDGE_DIALOUT_STRIP_PREFIX=
#BRIDGE_DIALOUT_INTERNAL_DIAL_PREFIX=
#BRIDGE_DIALOUT_NUMBER_ALLOWLIST=

# Off by default - see docs/CONFIG.md before enabling.
#BRIDGE_AUTO_ANSWER=false

# Must be reachable from the Nextcloud container/host, never a public
# interface - e.g. the Docker bridge gateway address.
BRIDGE_CONTROL_BIND=127.0.0.1
BRIDGE_CONTROL_PORT=8765
