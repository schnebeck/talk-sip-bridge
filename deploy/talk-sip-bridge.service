[Unit]
Description=Talk SIP Bridge daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/talk-sip-bridge/env
ExecStart=/opt/talk-sip-bridge-venv/bin/python3 -u /opt/talk-sip-bridge/daemon.py
WorkingDirectory=/opt/talk-sip-bridge
Restart=on-failure
RestartSec=5
User=talk-sip-bridge
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The one writable directory this hardened service gets: /var/lib/talk-sip-
# talk-bridge, auto-created and owned by the service user - holds small
# per-line state files (currently just whether registration should be on)
# so a crash-triggered restart can resume automatically instead of
# silently leaving the phone line deregistered. See config.py's state_dir.
StateDirectory=talk-sip-bridge
StateDirectoryMode=0700
UMask=0077

# Additional sandboxing - scoped entirely to this one service, no impact on
# anything else running on the host. Deliberately not including
# MemoryDenyWriteExecute=: aiortc pulls in a lot of native code (libavcodec,
# OpenSSL, ...) and the risk of subtly breaking a codec/crypto path isn't
# worth it without a supervised test.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK is required by aiortc/aioice's ICE candidate gathering
# (ifaddr.get_adapters() enumerates network interfaces over a netlink
# socket) - without it, setLocalDescription() on the call-audio publish
# fails with EAFNOSUPPORT and the call never gets audio.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
