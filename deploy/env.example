# Template for /etc/talk-sip-bridge/env (chmod 600, owned by the
# service user - contains credentials). See docs/CONFIG.md for the full
# reference of every variable and when each one is needed.
#
# This is the single-line form. For more than one SIP line/number (see
# docs/CONFIG.md "Single line vs. multiple lines"), set BRIDGE_LINES
# instead and drop the flat BRIDGE_SIP_USER/etc. below in favor of
# BRIDGE_LINE_<id>_SIP_USER/etc. per line.

BRIDGE_SIP_USER=
BRIDGE_SIP_PASS=
BRIDGE_GATEWAY_HOST=
BRIDGE_LOCAL_IP=

# udp (default) or tcp. A registrar that accepts only one of them drops the
# other without a word, so a wrong value looks like a network fault.
#BRIDGE_SIP_TRANSPORT=udp

# Only needed if a relay sits between this host and the gateway (see
# docs/CONFIG.md "Media relay") - leave unset for direct reachability.
# BRIDGE_CONTACT_TRANSPORT belongs here too when the relay changes
# transport on the way: the bridge speaks UDP to it, it speaks TCP onwards,
# and the gateway has to be told TCP.
#BRIDGE_CONTACT_TRANSPORT=tcp
#BRIDGE_PROXY_HOST=
#BRIDGE_PROXY_PORT=
#BRIDGE_CONTACT_HOST=
#BRIDGE_CONTACT_PORT=
#BRIDGE_RELAY_LAN_HOST=
#BRIDGE_RELAY_LAN_PORT=
#BRIDGE_RELAY_OVERLAY_HOST=
#BRIDGE_RELAY_OVERLAY_PORT=

BRIDGE_WS_URL=
BRIDGE_INTERNAL_SECRET=
BRIDGE_BACKEND_URL=
BRIDGE_DEFAULT_ROOM=

# Number handling for Talk's "call a phone number" UI - see docs/CONFIG.md.
#BRIDGE_DIALOUT_STRIP_PREFIX=
#BRIDGE_DIALOUT_INTERNAL_DIAL_PREFIX=
#BRIDGE_DIALOUT_NUMBER_ALLOWLIST=

# Off by default - see docs/CONFIG.md before enabling.
#BRIDGE_AUTO_ANSWER=false

# Must be reachable from the Nextcloud container/host, never a public
# interface - e.g. the Docker bridge gateway address.
BRIDGE_CONTROL_BIND=127.0.0.1
BRIDGE_CONTROL_PORT=8765
