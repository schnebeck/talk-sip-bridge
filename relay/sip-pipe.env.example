# One route per direction, "listen_ip:port->target_ip:port", comma separated.
#
# outbound: the bridge connects to the overlay address, this connects on
#           to the gateway
# inbound:  the gateway connects to the address in the bridge's Contact
#           header, this connects on to the bridge's own SIP port
#
# One pair per line. Giving each line its own ports is what keeps them
# apart - unlike a single static routing rule, which can only ever point
# at one of them.
SIP_PIPE_ROUTES=10.1.1.5:5070->192.168.1.1:5060,192.168.1.10:5070->10.1.1.1:5091

# Who may connect. Empty means anyone who can reach the port, which on a
# host with a foot in two networks is more than intended.
SIP_PIPE_PEERS=10.1.1.1,192.168.1.1
