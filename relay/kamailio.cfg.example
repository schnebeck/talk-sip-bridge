#!KAMAILIO

debug=2
log_stderror=yes
fork=yes
children=2

listen=udp:10.1.1.5:5070
listen=tcp:10.1.1.5:5070
listen=tcp:192.168.1.10:5070

mpath="/usr/lib/x86_64-linux-gnu/kamailio/modules/"

loadmodule "tm.so"
loadmodule "sl.so"
loadmodule "xlog.so"
loadmodule "pv.so"

modparam("tm", "fr_timer", 5000)
modparam("tm", "fr_inv_timer", 30000)

request_route {
	if ($si == "192.168.1.1") {
		# From the FritzBox (e.g. an incoming INVITE) -> relay to the bridge
		# on 10.1.1.1 via UDP (that's what the bridge daemon listens on).
		xlog("L_INFO", "relaying $rm from FritzBox to bridge (10.1.1.1)\n");
		$du = "sip:10.1.1.1:5091";
	} else {
		# From the bridge (e.g. REGISTER) -> relay to the FritzBox via TCP
		# (the only transport it accepts).
		xlog("L_INFO", "relaying $rm from $si:$sp to FritzBox via TCP\n");
		$du = "sip:192.168.1.1:5060;transport=tcp";
	}
	if (!t_relay()) {
		sl_reply_error();
	}
}
