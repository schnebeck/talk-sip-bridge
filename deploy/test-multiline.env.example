BRIDGE_WS_URL=ws://127.0.0.1:8080/spreed
BRIDGE_INTERNAL_SECRET=CHANGE_ME
BRIDGE_BACKEND_URL=https://nextcloud.example

BRIDGE_AUTO_ANSWER=true

# Separate from the production control port (8765) so both can run at once.
BRIDGE_CONTROL_BIND=127.0.0.1
BRIDGE_CONTROL_PORT=8766
