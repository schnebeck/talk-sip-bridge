# Ten-line concurrency test env - deliberately separate from the real
# deploy/env.example. Run manually (not as the systemd service, and not on
# the production control port) so this never touches the production line:
#
#   set -a; source test-multiline.env; set +a
#   /opt/fritzbox-talk-bridge-venv/bin/python3 /opt/fritzbox-talk-bridge/daemon.py
#
# Register 10 extra FritzBox SIP devices first (BRIDGE_LINE_l1..l10_SIP_USER/
# PASS below must match them), then use 10 other devices/softphones to call
# each of the ten in parallel to verify the bridge handles that many
# concurrent calls correctly.
#
# BRIDGE_AUTO_ANSWER=true here only so an unattended concurrency test has
# something to actually connect and hold real audio for - never set this on
# the production line (see docs/CONFIG.md).

BRIDGE_LOCAL_IP=10.1.1.1
BRIDGE_LINES=l1,l2,l3,l4,l5,l6,l7,l8,l9,l10

BRIDGE_LINE_l1_SIP_USER=sip-test1
BRIDGE_LINE_l1_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l1_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l1_LOCAL_SIP_PORT=5101
BRIDGE_LINE_l1_LOCAL_RTP_PORT=41000
BRIDGE_LINE_l1_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l2_SIP_USER=sip-test2
BRIDGE_LINE_l2_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l2_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l2_LOCAL_SIP_PORT=5102
BRIDGE_LINE_l2_LOCAL_RTP_PORT=41010
BRIDGE_LINE_l2_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l3_SIP_USER=sip-test3
BRIDGE_LINE_l3_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l3_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l3_LOCAL_SIP_PORT=5103
BRIDGE_LINE_l3_LOCAL_RTP_PORT=41020
BRIDGE_LINE_l3_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l4_SIP_USER=sip-test4
BRIDGE_LINE_l4_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l4_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l4_LOCAL_SIP_PORT=5104
BRIDGE_LINE_l4_LOCAL_RTP_PORT=41030
BRIDGE_LINE_l4_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l5_SIP_USER=sip-test5
BRIDGE_LINE_l5_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l5_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l5_LOCAL_SIP_PORT=5105
BRIDGE_LINE_l5_LOCAL_RTP_PORT=41040
BRIDGE_LINE_l5_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l6_SIP_USER=sip-test6
BRIDGE_LINE_l6_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l6_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l6_LOCAL_SIP_PORT=5106
BRIDGE_LINE_l6_LOCAL_RTP_PORT=41050
BRIDGE_LINE_l6_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l7_SIP_USER=sip-test7
BRIDGE_LINE_l7_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l7_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l7_LOCAL_SIP_PORT=5107
BRIDGE_LINE_l7_LOCAL_RTP_PORT=41060
BRIDGE_LINE_l7_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l8_SIP_USER=sip-test8
BRIDGE_LINE_l8_SIP_PASS=CHANGE_ME
BRIDGE_LINE_l8_GATEWAY_HOST=192.168.1.1
BRIDGE_LINE_l8_LOCAL_SIP_PORT=5108
BRIDGE_LINE_l8_LOCAL_RTP_PORT=41070
BRIDGE_LINE_l8_DEFAULT_ROOM=CHANGE_ME

BRIDGE_LINE_l9_SIP_USER=sip-test9
